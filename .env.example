# Optional local proxy configuration
WARDEN_PORT=8787
WARDEN_UPSTREAM_BASE_URL=https://api.anthropic.com

# Optional local-only token checked by Warden on inbound requests.
# Replace with a high-entropy value if you enable it.
# WARDEN_AUTH_TOKEN=replace-with-local-token

# Optional dashboard sync endpoint. Do not commit real organization tokens.
# WARDEN_DASHBOARD_URL=https://dashboard.example.com/api/sync
