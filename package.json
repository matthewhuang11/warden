{
  "name": "warden-proxy",
  "version": "0.1.0",
  "description": "Local proxy for Claude Code / Cursor that obfuscates local identifiers before requests leave the machine and rehydrates them on the way back.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matthewhuang11/warden.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "warden-proxy": "dist/cli.js",
    "warden": "dist/cli.js"
  },
  "files": [
    "dist",
    "grammars"
  ],
  "scripts": {
    "setup": "bash setup.sh",
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "demo": "tsx examples/demo.ts",
    "fuzz": "bash scripts/fuzz.sh",
    "fuzz:batch": "bash scripts/fuzz-batch.sh",
    "stealth:harness": "npm run build && tsx scripts/stealth-harness.ts",
    "local:model-harness": "tsx scripts/local-model-cover-story-harness.ts",
    "verify": "bash scripts/verify.sh",
    "verify:package": "node scripts/verify-package.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "web-tree-sitter": "^0.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tree-sitter-wasms": "^0.1.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
