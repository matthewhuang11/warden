{
  "name": "warden-proxy",
  "version": "0.1.0",
  "description": "Local proxy for Claude Code / Cursor that obfuscates local identifiers before requests leave the machine and rehydrates them on the way back.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "warden-proxy": "dist/cli.js"
  },
  "files": [
    "dist",
    "grammars"
  ],
  "scripts": {
    "setup": "bash setup.sh",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "web-tree-sitter": "^0.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tree-sitter-wasms": "^0.1.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
